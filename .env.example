# Copy to .env.local for local work; set the same keys in Vercel → Settings → Environment Variables.
# Every NEXT_PUBLIC_ value is baked in at build time: redeploy after changing one.

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://shibonk.xyz

# Token mint. Leave empty to fall back to the live Shibonk mint (treated as launched).
NEXT_PUBLIC_TOKEN_CA=HzUYtB8HSRTuEqQ3KR3wTW4nhBv8xZtFy3nFQrrHpump

# Optional: Raydium pair address (makes the DEXScreener link point at the exact pool).
NEXT_PUBLIC_PAIR_ADDRESS=

# "true" once a pool is live. The live mint above is treated as launched even if this is unset.
NEXT_PUBLIC_LAUNCHED=true

# Launch time in ISO format (UTC). Only used for the pre-launch countdown.
NEXT_PUBLIC_LAUNCH_DATE=

# Official socials. X left empty is shown as "announced at launch", never as a dead link.
# Telegram falls back to https://t.me/shibonkonsol when unset.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/shibonkonsol

# Optional overrides. Leave unset to derive Pump.fun and Block X from the mint.
# NEXT_PUBLIC_PUMP_URL=
# NEXT_PUBLIC_BLOCKX_URL=
