# Copy to .env.local for local work; set the same keys in Vercel → Settings → Environment Variables.
# Every NEXT_PUBLIC_ value is baked in at build time: redeploy after changing one.

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://shibonk.xyz

# Token mint address. Leave empty before launch: the site then shows "drops at launch".
NEXT_PUBLIC_TOKEN_CA=

# Optional: Raydium pair address (makes the DEXScreener link point at the exact pool).
NEXT_PUBLIC_PAIR_ADDRESS=

# "true" once the pool is live. Needs NEXT_PUBLIC_TOKEN_CA to be set, otherwise ignored.
NEXT_PUBLIC_LAUNCHED=false

# Launch time in ISO format (UTC). Shows a countdown before launch. Leave empty for "Launching soon".
NEXT_PUBLIC_LAUNCH_DATE=

# Official socials. A link left empty is shown as "announced at launch", never as a dead link.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
